# CDK synth/deploy時に問題サーバーへ渡す設定
CLOUD_VAULT_CTF_EVENT_NAME='Cloud Vault CTF'
CLOUD_VAULT_CTF_CHALLENGE_ID=cloud-vault
CLOUD_VAULT_CTF_TITLE='Cloud Vault — TechVault侵害調査'
CLOUD_VAULT_CTF_DESCRIPTION='TechVault社からクラウド情報漏洩の調査を依頼されました。社員ポータルを起点に漏洩経路を追い、Floci上に残された最終証拠を回収してください。'
CLOUD_VAULT_CTF_CATEGORY='Cloud / DFIR'
CLOUD_VAULT_CTF_DIFFICULTY=Scenario
CLOUD_VAULT_CTF_POINTS=500
CLOUD_VAULT_CTF_HINTS_JSON='["robots.txt とHTMLソースを確認してください。","ログインに失敗したときのAPIレスポンスを確認してください。","漏洩した認証情報を設定し、FlociのS3バケットを調べてください。"]'
CLOUD_VAULT_CTF_TARGET_URL=''
# CTFダッシュボードのBasic認証（問題環境側には適用されません）
CLOUD_VAULT_DASHBOARD_USERNAME=cloudvault
CLOUD_VAULT_DASHBOARD_PASSWORD=vault-ctf-2026
# 正解値はCDKプロセス内でSHA-256化され、Lambdaにはハッシュだけを渡します。
CLOUD_VAULT_CTF_FLAG=TVAULT{cloud_security_matters_always}
