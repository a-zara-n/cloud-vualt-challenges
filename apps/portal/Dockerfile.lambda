FROM oven/bun:1 AS deps

WORKDIR /app

COPY package.json bun.lock bunfig.toml ./
COPY apps/portal/package.json apps/portal/package.json
COPY scenario/init/package.json scenario/init/package.json
RUN bun install --filter portal

FROM deps AS builder

COPY apps/portal apps/portal

WORKDIR /app/apps/portal
ENV NEXT_TELEMETRY_DISABLED=1
RUN bun run build

FROM public.ecr.aws/docker/library/node:22-bookworm-slim AS runner

WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=3000
ENV AWS_LWA_PORT=3000
ENV AWS_LWA_ENABLE_COMPRESSION=true

COPY --from=public.ecr.aws/awsguru/aws-lambda-adapter:0.9.1 /lambda-adapter /opt/extensions/lambda-adapter
COPY --from=builder /app/apps/portal/.next/standalone ./
COPY --from=builder /app/apps/portal/.next/static ./apps/portal/.next/static
COPY --from=builder /app/apps/portal/public ./apps/portal/public

CMD ["node", "apps/portal/server.js"]
